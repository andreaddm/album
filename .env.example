# URL del progetto Supabase (impostazioni → API).
NEXT_PUBLIC_SUPABASE_URL=

# Chiave anon/publishable. Può essere esposta al browser; le policy RLS limitano l'accesso.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave segreta del server (sb_secret_... oppure la vecchia service_role).
# Solo server. Non prefissare con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico del sito, usato in seguito per metadata e link nelle email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token personale dell'account Supabase, solo per applicare le migrazioni in locale.
# Si revoca da Account → Access Tokens. Non prefissare con NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# Provider email: "console" (log in terminale, utile in locale) oppure "resend".
# Se manca e non c'è RESEND_API_KEY, viene usato console.
EMAIL_PROVIDER=console

# Mittente Resend (es. Album <notifiche@tuodominio.it>).
EMAIL_FROM=

# Chiave API Resend, solo server. Non prefissare con NEXT_PUBLIC_.
RESEND_API_KEY=

# Se true, dopo una richiesta viene inviata anche la ricevuta al cliente.
# Di default (assente o false) parte solo la notifica al venditore.
EMAIL_SEND_CUSTOMER_RECEIPT=false
